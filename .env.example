# Copie para .env e preencha. NUNCA versione o arquivo .env
# --- Banco PostgreSQL do Billing Service ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=billing_db
DB_USER=billing_user
DB_PASSWORD=troque-esta-senha

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=garage
RABBITMQ_PASSWORD=troque-esta-senha

# --- JWT (mesmo valor do OS Service) ---
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# --- Provedor de pagamento (Mercado Pago) ---
# Padrão: simulador do repositório payment-mock-service (mesmo contrato da API do Mercado Pago)
MP_API_BASE_URL=http://localhost:8084
# Token aceito pelo provedor (no simulador = MOCK_ACCESS_TOKEN; no Mercado Pago real = Access Token de teste)
MP_ACCESS_TOKEN=TEST-troque-este-token
# Segredo de assinatura dos webhooks (no simulador = MOCK_WEBHOOK_SECRET)
MP_WEBHOOK_SECRET=troque-este-segredo
# URL do billing vista pelo navegador (links do e-mail e retorno do checkout)
APP_PUBLIC_BASE_URL=http://localhost:8082
# URL do webhook vista pelo provedor (padrão: APP_PUBLIC_BASE_URL/webhooks/mercadopago)
# MP_NOTIFICATION_URL=http://billing-service:8082/webhooks/mercadopago

# --- E-mail (MailHog em desenvolvimento) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@garagesystem.com

# --- Observabilidade ---
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
